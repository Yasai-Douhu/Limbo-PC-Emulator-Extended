<?xml version="1.0" encoding="utf-8"?>
<!--
  Limbo PC Emulator 7.0.0
  Windows準拠 仮想ビルトインキーボード & マウスクイックバー
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/virtual_keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#16181C"
    android:orientation="vertical"
    android:padding="2dp">

    <!-- 1. 最上部: マウスクイックバー (左クリック、ホイール、右クリック、キーボード最小化) -->
    <LinearLayout
        android:id="@+id/mouse_quick_bar"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 左クリックボタン (タップでクリック、長押しでホールド/ドラッグ) -->
        <Button
            android:id="@+id/vk_mouse_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="1dp"
            android:layout_weight="1.2"
            android:background="@drawable/vk_mouse_btn_bg"
            android:gravity="center"
            android:text="L-Click"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 中央: マウスホイール操作エリア (スクロールUP/DOWNボタン + スワイプホイール) -->
        <LinearLayout
            android:id="@+id/vk_mouse_wheel_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="1dp"
            android:layout_weight="1.6"
            android:background="@drawable/vk_wheel_bg"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/vk_wheel_up"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:text="▲ UP"
                android:textColor="#90CAF9"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/vk_wheel_center"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:gravity="center"
                android:text="WHEEL"
                android:textColor="#AAAAAA"
                android:textSize="9sp" />

            <Button
                android:id="@+id/vk_wheel_down"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:text="▼ DOWN"
                android:textColor="#90CAF9"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 右クリックボタン (タップでクリック、長押しでホールド) -->
        <Button
            android:id="@+id/vk_mouse_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="1dp"
            android:layout_weight="1.2"
            android:background="@drawable/vk_mouse_btn_bg"
            android:gravity="center"
            android:text="R-Click"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- キーボード折りたたみ/展開ボタン -->
        <Button
            android:id="@+id/vk_btn_minimize"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:layout_margin="1dp"
            android:background="@drawable/vk_key_bg"
            android:gravity="center"
            android:text="▼"
            android:textColor="#CCCCCC"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 2. キーボード本体コンテナ -->
    <LinearLayout
        android:id="@+id/vk_keyboard_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ==================== メインキーボード面 (QWERTY) ==================== -->
        <LinearLayout
            android:id="@+id/vk_layout_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- 行1: Esc, Tab, `, 1-0, -, =, BS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal">

                <Button android:id="@+id/vk_key_esc" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="Esc" />
                <Button android:id="@+id/vk_key_tab" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="Tab" />
                <Button android:id="@+id/vk_key_grave" style="@style/VirtualKeyStyle" android:layout_weight="0.8" android:text="`" />
                <Button android:id="@+id/vk_key_1" style="@style/VirtualKeyStyle" android:layout_weight="0.8" android:text="1" />
                <Button android:id="@+id/vk_key_2" style="@style/VirtualKeyStyle" android:layout_weight="0.8" android:text="2" />
                <Button android:id="@+id/vk_key_3" style="@style/VirtualKeyStyle" android:layout_weight="0.8" android:text="3" />
                <Button android:id="@+id/vk_key_4" style="@style/VirtualKeyStyle" android:layout_weight="0.8" android:text="4" />
                <Button android:id="@+id/vk_key_5" style="@style/VirtualKeyStyle" android:layout_weight="0.8" android:text="5" />
                <Button android:id="@+id/vk_key_6" style="@style/VirtualKeyStyle" android:layout_weight="0.8" android:text="6" />
                <Button android:id="@+id/vk_key_7" style="@style/VirtualKeyStyle" android:layout_weight="0.8" android:text="7" />
                <Button android:id="@+id/vk_key_8" style="@style/VirtualKeyStyle" android:layout_weight="0.8" android:text="8" />
                <Button android:id="@+id/vk_key_9" style="@style/VirtualKeyStyle" android:layout_weight="0.8" android:text="9" />
                <Button android:id="@+id/vk_key_0" style="@style/VirtualKeyStyle" android:layout_weight="0.8" android:text="0" />
                <Button android:id="@+id/vk_key_minus" style="@style/VirtualKeyStyle" android:layout_weight="0.8" android:text="-" />
                <Button android:id="@+id/vk_key_equals" style="@style/VirtualKeyStyle" android:layout_weight="0.8" android:text="=" />
                <Button android:id="@+id/vk_key_backspace" style="@style/VirtualKeyStyle" android:layout_weight="1.3" android:text="BS" />
            </LinearLayout>

            <!-- 行2: Q, W, E, R, T, Y, U, I, O, P, [, ], \, Del -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal">

                <Button android:id="@+id/vk_key_q" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="Q" />
                <Button android:id="@+id/vk_key_w" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="W" />
                <Button android:id="@+id/vk_key_e" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="E" />
                <Button android:id="@+id/vk_key_r" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="R" />
                <Button android:id="@+id/vk_key_t" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="T" />
                <Button android:id="@+id/vk_key_y" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="Y" />
                <Button android:id="@+id/vk_key_u" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="U" />
                <Button android:id="@+id/vk_key_i" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="I" />
                <Button android:id="@+id/vk_key_o" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="O" />
                <Button android:id="@+id/vk_key_p" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="P" />
                <Button android:id="@+id/vk_key_left_bracket" style="@style/VirtualKeyStyle" android:layout_weight="0.8" android:text="[" />
                <Button android:id="@+id/vk_key_right_bracket" style="@style/VirtualKeyStyle" android:layout_weight="0.8" android:text="]" />
                <Button android:id="@+id/vk_key_backslash" style="@style/VirtualKeyStyle" android:layout_weight="0.8" android:text="\\" />
                <Button android:id="@+id/vk_key_delete" style="@style/VirtualKeyStyle" android:layout_weight="1.1" android:text="Del" />
            </LinearLayout>

            <!-- 行3: Caps, A, S, D, F, G, H, J, K, L, ;, ', Enter -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal">

                <Button android:id="@+id/vk_key_caps" style="@style/VirtualKeyStyle" android:layout_weight="1.3" android:text="Caps" />
                <Button android:id="@+id/vk_key_a" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="A" />
                <Button android:id="@+id/vk_key_s" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="S" />
                <Button android:id="@+id/vk_key_d" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="D" />
                <Button android:id="@+id/vk_key_f" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="F" />
                <Button android:id="@+id/vk_key_g" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="G" />
                <Button android:id="@+id/vk_key_h" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="H" />
                <Button android:id="@+id/vk_key_j" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="J" />
                <Button android:id="@+id/vk_key_k" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="K" />
                <Button android:id="@+id/vk_key_l" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="L" />
                <Button android:id="@+id/vk_key_semicolon" style="@style/VirtualKeyStyle" android:layout_weight="0.9" android:text=";" />
                <Button android:id="@+id/vk_key_apostrophe" style="@style/VirtualKeyStyle" android:layout_weight="0.9" android:text="'" />
                <Button android:id="@+id/vk_key_enter" style="@style/VirtualKeyStyle" android:layout_weight="1.5" android:text="Enter" />
            </LinearLayout>

            <!-- 行4: Shift, Z, X, C, V, B, N, M, ,, ., /, Shift -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal">

                <Button android:id="@+id/vk_key_shift_left" style="@style/VirtualKeyStyle" android:layout_weight="1.5" android:text="Shift" />
                <Button android:id="@+id/vk_key_z" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="Z" />
                <Button android:id="@+id/vk_key_x" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="X" />
                <Button android:id="@+id/vk_key_c" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="C" />
                <Button android:id="@+id/vk_key_v" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="V" />
                <Button android:id="@+id/vk_key_b" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="B" />
                <Button android:id="@+id/vk_key_n" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="N" />
                <Button android:id="@+id/vk_key_m" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="M" />
                <Button android:id="@+id/vk_key_comma" style="@style/VirtualKeyStyle" android:layout_weight="0.9" android:text="," />
                <Button android:id="@+id/vk_key_period" style="@style/VirtualKeyStyle" android:layout_weight="0.9" android:text="." />
                <Button android:id="@+id/vk_key_slash" style="@style/VirtualKeyStyle" android:layout_weight="0.9" android:text="/" />
                <Button android:id="@+id/vk_key_shift_right" style="@style/VirtualKeyStyle" android:layout_weight="1.5" android:text="Shift" />
            </LinearLayout>

            <!-- 行5: Ctrl, Win, Alt, Space, Alt, Fn, Left, Up/Down, Right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:orientation="horizontal">

                <Button android:id="@+id/vk_key_ctrl" style="@style/VirtualKeyStyle" android:layout_weight="1.3" android:text="Ctrl" />
                <Button android:id="@+id/vk_key_win" style="@style/VirtualKeyStyle" android:layout_weight="1.1" android:text="Win" />
                <Button android:id="@+id/vk_key_alt" style="@style/VirtualKeyStyle" android:layout_weight="1.2" android:text="Alt" />
                <Button android:id="@+id/vk_key_space" style="@style/VirtualKeyStyle" android:layout_weight="3.2" android:text="Space" />
                <Button android:id="@+id/vk_key_alt_gr" style="@style/VirtualKeyStyle" android:layout_weight="1.1" android:text="Alt" />
                <Button android:id="@+id/vk_key_fn" style="@style/VirtualKeyStyle" android:layout_weight="1.2" android:text="Fn" android:textColor="#80D8FF" />
                <Button android:id="@+id/vk_key_left" style="@style/VirtualKeyStyle" android:layout_weight="0.9" android:text="◀" />
                
                <!-- 上下キーの縦分割 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.9"
                    android:orientation="vertical">
                    <Button android:id="@+id/vk_key_up" style="@style/VirtualKeyStyle" android:layout_height="0dp" android:layout_weight="1" android:text="▲" android:textSize="8sp" />
                    <Button android:id="@+id/vk_key_down" style="@style/VirtualKeyStyle" android:layout_height="0dp" android:layout_weight="1" android:text="▼" android:textSize="8sp" />
                </LinearLayout>

                <Button android:id="@+id/vk_key_right" style="@style/VirtualKeyStyle" android:layout_weight="0.9" android:text="▶" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== サブキーボード面 (Fn切り替え時: ファンクション、ナビゲーション、本格テンキー) ==================== -->
        <LinearLayout
            android:id="@+id/vk_layout_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 行1: F1-F6 (左側) & Num, /, *, - (右側テンキー) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal">

                <Button android:id="@+id/vk_key_f1" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="F1" />
                <Button android:id="@+id/vk_key_f2" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="F2" />
                <Button android:id="@+id/vk_key_f3" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="F3" />
                <Button android:id="@+id/vk_key_f4" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="F4" />
                <Button android:id="@+id/vk_key_f5" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="F5" />
                <Button android:id="@+id/vk_key_f6" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="F6" />

                <Button android:id="@+id/vk_num_lock" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="Num" />
                <Button android:id="@+id/vk_num_slash" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="/" />
                <Button android:id="@+id/vk_num_star" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="*" />
                <Button android:id="@+id/vk_num_minus" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="-" />
            </LinearLayout>

            <!-- 行2: F7-F12 (左側) & 7, 8, 9, + (右側テンキー) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal">

                <Button android:id="@+id/vk_key_f7" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="F7" />
                <Button android:id="@+id/vk_key_f8" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="F8" />
                <Button android:id="@+id/vk_key_f9" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="F9" />
                <Button android:id="@+id/vk_key_f10" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="F10" />
                <Button android:id="@+id/vk_key_f11" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="F11" />
                <Button android:id="@+id/vk_key_f12" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="F12" />

                <Button android:id="@+id/vk_num_7" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="7" />
                <Button android:id="@+id/vk_num_8" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="8" />
                <Button android:id="@+id/vk_num_9" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="9" />
                <Button android:id="@+id/vk_num_plus" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="+" />
            </LinearLayout>

            <!-- 行3: PrtSc, ScLk, Pause, Ins (左側) & 4, 5, 6, ( (右側テンキー) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal">

                <Button android:id="@+id/vk_key_prtsc" style="@style/VirtualKeyStyle" android:layout_weight="1.5" android:text="PrtSc" />
                <Button android:id="@+id/vk_key_sclk" style="@style/VirtualKeyStyle" android:layout_weight="1.5" android:text="ScLk" />
                <Button android:id="@+id/vk_key_pause" style="@style/VirtualKeyStyle" android:layout_weight="1.5" android:text="Pause" />
                <Button android:id="@+id/vk_key_insert" style="@style/VirtualKeyStyle" android:layout_weight="1.5" android:text="Ins" />

                <Button android:id="@+id/vk_num_4" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="4" />
                <Button android:id="@+id/vk_num_5" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="5" />
                <Button android:id="@+id/vk_num_6" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="6" />
                <Button android:id="@+id/vk_num_left_paren" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="(" />
            </LinearLayout>

            <!-- 行4: Home, End, PgUp, PgDn (左側) & 1, 2, 3, ) (右側テンキー) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal">

                <Button android:id="@+id/vk_key_home" style="@style/VirtualKeyStyle" android:layout_weight="1.5" android:text="Home" />
                <Button android:id="@+id/vk_key_end" style="@style/VirtualKeyStyle" android:layout_weight="1.5" android:text="End" />
                <Button android:id="@+id/vk_key_pgup" style="@style/VirtualKeyStyle" android:layout_weight="1.5" android:text="PgUp" />
                <Button android:id="@+id/vk_key_pgdn" style="@style/VirtualKeyStyle" android:layout_weight="1.5" android:text="PgDn" />

                <Button android:id="@+id/vk_num_1" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="1" />
                <Button android:id="@+id/vk_num_2" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="2" />
                <Button android:id="@+id/vk_num_3" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="3" />
                <Button android:id="@+id/vk_num_right_paren" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text=")" />
            </LinearLayout>

            <!-- 行5: Fn戻る, Esc, Tab, Del (左側) & 0, ., Enter (右側テンキー) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/vk_key_fn_back"
                    style="@style/VirtualKeyStyle"
                    android:layout_weight="2.4"
                    android:text="◀ QWERTY (Fn)"
                    android:textColor="#80D8FF"
                    android:textStyle="bold" />

                <Button android:id="@+id/vk_key_sub_esc" style="@style/VirtualKeyStyle" android:layout_weight="1.2" android:text="Esc" />
                <Button android:id="@+id/vk_key_sub_tab" style="@style/VirtualKeyStyle" android:layout_weight="1.2" android:text="Tab" />
                <Button android:id="@+id/vk_key_sub_del" style="@style/VirtualKeyStyle" android:layout_weight="1.2" android:text="Del" />

                <Button android:id="@+id/vk_num_0" style="@style/VirtualKeyStyle" android:layout_weight="2.0" android:text="0" />
                <Button android:id="@+id/vk_num_dot" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="." />
                <Button android:id="@+id/vk_num_enter" style="@style/VirtualKeyStyle" android:layout_weight="1.0" android:text="Enter" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

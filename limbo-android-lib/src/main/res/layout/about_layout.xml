<?xml version="1.0" encoding="utf-8"?>
<!-- バージョン情報セクションレイアウト -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aboutsectionl"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/border"
    android:orientation="vertical"
    android:padding="15dp">

    <LinearLayout
        android:id="@+id/aboutheaderl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/limbo" />

        <TextView
            android:id="@+id/aboutsectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:text="バージョン情報"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:paddingLeft="5dp"
        android:paddingRight="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Limbo バージョン: "
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/about_limbo_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7.0.0"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QEMU コア: "
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/about_qemu_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QEMU 9.2.0"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ターゲットアーキテクチャ: "
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/about_target_arch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ビルド日時: "
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/about_build_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

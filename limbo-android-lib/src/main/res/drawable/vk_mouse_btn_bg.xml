<?xml version="1.0" encoding="utf-8"?>
<!-- マウスクイックバー ボタン背景: 押下時にハイライト表示するセレクター -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 押下中の状態: 緑系ハイライト (クリック感のある緑) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2E7D32" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#4CAF50" />
        </shape>
    </item>
    <!-- 通常状態 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#21252B" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#3A3F4B" />
        </shape>
    </item>
</selector>

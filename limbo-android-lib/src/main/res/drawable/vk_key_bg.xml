<?xml version="1.0" encoding="utf-8"?>
<!-- 仮想キーボード 通常キー背景: 押下時にハイライト表示するセレクター -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 押下中の状態: 明るいハイライト色 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#5C7AEA" />
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="#7A9BFF" />
        </shape>
    </item>
    <!-- フォーカス状態 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3A4A7A" />
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="#5C7AEA" />
        </shape>
    </item>
    <!-- 通常状態 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2B2D30" />
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="#3C3F41" />
        </shape>
    </item>
</selector>
